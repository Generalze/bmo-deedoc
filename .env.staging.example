# Staging environment contract.
#
# Copy to .env.staging on the staging VPS, fill in real values, keep it out of
# version control. Staging runs the production topology with production
# settings; it is not a relaxed environment, because an environment that is
# relaxed is not testing what you are about to ship.
#
# Three things must be true of staging, and they are the reason this file exists
# separately from .env.production.example rather than being a copy of it:
#
#   1. Staging never touches production data. Different database, different
#      bucket, different Redis. A staging instance pointed at production storage
#      would let a UAT tester open a real member's identity document.
#   2. Staging carries synthetic people only. Real voter records are personal
#      data belonging to real Nigerians and do not belong in a test system.
#   3. Payouts stay off. Staging is where the payout flow is exercised through
#      to its refusal, not where money moves.
#
# Everything not commented below has the same meaning as in
# .env.production.example; read that file for the full contract.

NODE_ENV=production

# ---------------------------------------------------------------------------
# Database — MUST NOT be a production host or database name.
# ---------------------------------------------------------------------------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=ogun_staging
DATABASE_URL=postgresql://USER:PASSWORD@postgres:5432/ogun_staging?schema=public

# ---------------------------------------------------------------------------
# Redis. Transient. An empty Redis on staging is an expected state.
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=
# Staging exercises the same fail-closed realtime behaviour as production, so
# that a broken adapter is discovered here rather than on election day.
REALTIME_REQUIRE_REDIS=true

# ---------------------------------------------------------------------------
# Secrets — generate fresh, never reuse production values.
#
# A staging JWT secret equal to production's means a token minted on staging is
# valid in production.
#   openssl rand -base64 48
# ---------------------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRES_IN=12h

# ---------------------------------------------------------------------------
# Public surface. A distinct hostname, so a tester cannot mistake one for the
# other and a cookie or CORS rule cannot span both.
# ---------------------------------------------------------------------------
APP_PUBLIC_HOSTNAME=staging.ops.example.org
ACME_EMAIL=
CORS_ALLOWED_ORIGINS=https://staging.ops.example.org
NEXT_PUBLIC_API_BASE_URL=https://staging.ops.example.org/api
NEXT_PUBLIC_REALTIME_URL=https://staging.ops.example.org
TRUST_PROXY_HOPS=1
API_JSON_BODY_LIMIT=12mb

# ---------------------------------------------------------------------------
# Object storage — a separate private bucket.
#
# Evidence and voter-registration documents are stored here. Both are personal
# data; voter documents are identity documents. The bucket must be private with
# no public read, and must not be the production bucket. See
# deploy/storage/bucket-policy.json.
# ---------------------------------------------------------------------------
STORAGE_DRIVER=s3
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=ogun-staging-private
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# TURN. Staging needs a working relay: a call that connects on a LAN and fails
# on a phone is exactly the defect staging exists to catch.
#
# Cross-check with: npm run verify:turn -- --env-file .env.staging
# ---------------------------------------------------------------------------
TURN_URL=turn:staging.ops.example.org:3478
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_REALM=staging.ops.example.org
TURN_EXTERNAL_IP=
TURN_PORT=3478
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
# TURN over TLS is opt-in. Leave both empty to run without it; setting only one
# refuses to start rather than advertising a listener with no certificate.
TURN_TLS_PORT=5349
TURN_TLS_CERT=
TURN_TLS_KEY=
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302

# ---------------------------------------------------------------------------
# Money.
#
# Stays false. Staging proves that the payout path refuses correctly, that the
# kill switch holds at the execution boundary, and that no legacy balance is
# spendable without an approved reconciliation policy. It does not move money.
#
# The post-deploy smoke test fails the deployment if this is true.
# ---------------------------------------------------------------------------
PAYOUT_EXECUTION_ENABLED=false

# ---------------------------------------------------------------------------
# Bootstrap.
#
# The super admin is the only real account staging needs. Everyone else is
# synthetic and comes from the staging persona bootstrap, which refuses to run
# against a database holding real members.
# ---------------------------------------------------------------------------
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Ogun Staging Super Admin

# ---------------------------------------------------------------------------
# Observability. Optional, and more useful here than in production: staging is
# where you find out whether a trace tells you anything.
# ---------------------------------------------------------------------------
ERROR_TRACKING_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=ogun-staging
LOG_LEVEL=info
