model Ward {
  id                       String                      @id
  name                     String
  stateId                  String
  lgaId                    String
  stateConstituencyId      String?
  sourceCode               String?
  sourceCodeNamespace      String?
  sourceNameAliases        String[]                    @default([])
  referenceImportReleaseId String?
  referenceImportedAt      DateTime?
  stateConstituencyEdgeInferred       Boolean          @default(false)
  stateConstituencyEdgeInferenceBasis String?
  /// The State Constituency a human approved for this ward, or null.
  ///
  /// Set only by an APPROVED governance decision, and cleared by the importer
  /// whenever it re-points the ward, so a non-null value always describes the
  /// edge the ward currently has. That is what lets the operational filter be a
  /// null check rather than a comparison between two columns, which Prisma
  /// cannot express in a relation filter.
  stateConstituencyEdgeApprovedForId  String?
  /// Last decision, for display only. Never authority: a REJECTED decision also
  /// stamps these, so presence of a timestamp does not mean approved.
  stateConstituencyEdgeReviewedAt     DateTime?
  stateConstituencyEdgeReviewedBy     String?
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  state                    State                       @relation(fields: [stateId], references: [id], onDelete: Cascade)
  lga                      LGA                         @relation(fields: [lgaId], references: [id], onDelete: Cascade)
  stateConstituency        StateConstituency?          @relation(fields: [stateConstituencyId], references: [id])
  referenceImportRelease   ReferenceDataImportRelease? @relation("WardReferenceImportRelease", fields: [referenceImportReleaseId], references: [id], onDelete: SetNull)
  pollingUnits             PollingUnit[]
  adminProfiles            AdminProfile[]
  candidateProfiles        CandidateProfile[]
  agentProfiles            AgentProfile[]
  voterProfiles            VoterProfile[]
  coordinatorProfiles      CoordinatorProfile[]
  candidates               Candidate[]
  polls                    Poll[]
  posts                    Post[]
  feedbackItems            Feedback[]
  agentActivities          AgentActivity[]
  incidents                Incident[]
  fieldTasks               FieldTask[]
  broadcastMessages        BroadcastMessage[]
  voterEngagementTasks     VoterEngagementTask[]
  campaignEvents           CampaignEvent[]
  electionDayReports       ElectionDayReport[]
  evidenceAssets           EvidenceAsset[]
  legalCases               LegalCase[]

  constituencyEdgeReviews  WardConstituencyEdgeReview[]

  @@unique([lgaId, name])
  @@unique([stateId, sourceCodeNamespace, sourceCode])
  @@index([stateId])
  @@index([lgaId])
  @@index([stateConstituencyId])
  @@index([referenceImportReleaseId])
  @@index([stateConstituencyEdgeInferred])
  @@index([stateConstituencyEdgeApprovedForId])
}

/// One human decision about one Ward -> State Constituency edge.
///
/// Append-only. A decision is about the *edge*, not the ward: an approval names
/// the exact State Constituency reviewed, so it cannot follow the ward if a
/// later release re-points it. Rejection records that a human looked and said
/// no; it never changes `Ward.stateConstituencyId`, because correcting the
/// mapping is a reference-data action and the importer owns that column.
model WardConstituencyEdgeReview {
  id                       String                            @id @default(cuid())
  wardId                   String
  stateConstituencyId      String
  outcome                  WardConstituencyEdgeReviewOutcome
  reason                   String
  /// The inference the reviewer was judging, copied at decision time so the
  /// record still explains itself after a later release changes the basis.
  inferenceBasis           String?
  referenceReleaseId       String?
  reviewerUserId           String
  decidedAt                DateTime                          @default(now())
  /// What the decision affected when it was made. The live governance list
  /// recomputes current counts; these preserve what the reviewer was shown.
  affectedMemberCount      Int                               @default(0)
  affectedCoordinatorCount Int                               @default(0)
  ward                     Ward                              @relation(fields: [wardId], references: [id], onDelete: Cascade)
  reviewer                 User                              @relation("WardConstituencyEdgeReviewer", fields: [reviewerUserId], references: [id])

  @@index([wardId, decidedAt])
  @@index([wardId, stateConstituencyId])
  @@index([outcome])
}

