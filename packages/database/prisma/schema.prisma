  /// crossed a threshold configured on an active Super Admin reward rule.
  /// Bonus points exist only through this path; no operator can mint them.
  REFERRAL_MILESTONE_REACHED
  /// Approved participation recorded against a poll, post, or engagement task.
  /// Previously written to the legacy RewardLedger; now routed through the one
  /// authoritative ledger so a single balance governs every money-out path.
  PARTICIPATION_APPROVED
  /// One-time credit of a migrated legacy balance, posted only after an
  /// approved equivalence ratio exists. Never automatic: a carryover stays
  /// non-spendable until a versioned reconciliation rule is applied.
  LEGACY_BALANCE_RECONCILED
}

/// Lifecycle of a legacy balance carried into the authoritative ledger.
///
/// A carryover preserves the member's legacy points without creating monetary
/// value from an unverified conversion assumption. PENDING balances are visible
/// to the member but never spendable, never payable, and never counted in the
/// eligible balance.
/// Lifecycle of an equivalence ratio between legacy and authoritative points.
/// Separate DRAFT and APPROVED states exist so proposing a ratio and authorising
/// it are two deliberate acts; one call can neither invent nor apply a valuation.
enum LegacyReconciliationPolicyStatus {
  DRAFT
  APPROVED
  RETIRED
}

enum LegacyCarryoverStatus {
  LEGACY_CARRYOVER_PENDING
  LEGACY_CARRYOVER_CONFIRMED
  /// Deliberately excluded by an operator decision with a recorded reason. The
  /// original rows and the snapshot remain for audit.
  LEGACY_CARRYOVER_VOID
}

/// Immutable audit record of one legacy-ledger migration run.
///
/// Records the totals needed to prove the cutover balanced: what existed
/// before, what was migrated, what remains pending, and what has since been
/// reconciled. Never edited to make totals fit — a correction is a new batch.
/// The approved equivalence between a legacy point and an authoritative one.
///
/// Reconciliation reads its ratio and version from here and nowhere else. The
/// endpoint previously accepted both in the request body, which made the caller
/// authoritative for a valuation — the same defect this cutover removed from the
/// redemption path, sitting on the one gateway that turns preserved carryover
/// into spendable points.
///
/// At most one policy may be APPROVED at a time, enforced by a partial unique
/// index created in the migration (Prisma cannot express a filtered index; do
/// not drop `LegacyReconciliationPolicy_single_approved_key`).
model LegacyReconciliationPolicy {
  id               String                           @id @default(cuid())
  /// Human-meaningful identifier recorded on every credit this policy produces.
  version          String                           @unique
  /// Authoritative points credited per legacy point.
  conversionRatio  Decimal                          @db.Decimal(12, 6)
  status           LegacyReconciliationPolicyStatus @default(DRAFT)
  /// Why governance set this ratio; carried into the audit trail.
  rationale        String?
  approvedAt       DateTime?
  approvedByUserId String?
  createdByUserId  String
  createdAt        DateTime                         @default(now())
  updatedAt        DateTime                         @updatedAt

  approvedByUser User?                    @relation("LegacyReconciliationPolicyApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  createdByUser  User                     @relation("LegacyReconciliationPolicyCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  carryovers     LegacyBalanceCarryover[]

  @@index([status])
}

model LegacyMigrationBatch {
  id                  String                   @id @default(cuid())
  executedAt          DateTime                 @default(now())
  executedByUserId    String?
  sourceLedger        String                   @default("RewardLedger")
  memberCount         Int
  /// Sum of legacy points across every member at snapshot time.
  beforeTotalPoints   Int
  /// Sum actually written into carryover records. Must equal beforeTotalPoints.
  migratedTotalPoints Int
  /// Sum still awaiting an approved equivalence ratio.
  pendingTotalPoints  Int
  /// Sum credited to the authoritative ledger so far under an approved rule.
  reconciledTotalPoints Int                    @default(0)
  /// SHA-256 over the ordered per-member snapshot, so the batch can be proven
  /// to describe the balances it claims.
  snapshotChecksum    String
  notes               String?
  createdAt           DateTime                 @default(now())
  carryovers          LegacyBalanceCarryover[]

  @@index([executedAt])
}

/// One member's preserved legacy balance.
///
/// Preserves the balance without asserting its value. `legacyPointBalance` is
/// what the legacy ledger held; `creditedPoints` is what was actually posted to
/// the authoritative ledger, and stays null until an approved
/// `reconciliationRuleVersion` and `conversionRatio` exist.
model LegacyBalanceCarryover {
  id                       String                @id @default(cuid())
  userId                   String
  migrationBatchId         String
  sourceLedger             String                @default("RewardLedger")
  /// Legacy row ids folded into this balance, so the snapshot is traceable to
  /// the exact rows it summarises.
  sourceRowIdsJson         Json
  /// Legacy earned points at snapshot time.
  legacyPointBalance       Int
  /// Legacy points already reserved by pending/approved/paid redemptions.
  legacyReservedPoints     Int                   @default(0)
  /// SHA-256 over this member's ordered source rows.
  rowChecksum              String
  status                   LegacyCarryoverStatus @default(LEGACY_CARRYOVER_PENDING)
  /// Null until an equivalence ratio is approved. 1.0 means parity; any other
  /// value is handled by the same mechanism without rewriting history.
  conversionRatio          Decimal?              @db.Decimal(12, 6)
  reconciliationRuleVersion String?
  /// The approved policy that produced this credit. Provenance: an auditor can
  /// trace a credited figure back to the governance decision that authorised it.
  reconciliationPolicyId    String?
  /// Points actually credited to the authoritative ledger.
  creditedPoints           Int?
  /// The authoritative ledger entry created by reconciliation, if any.
  reconciledLedgerEntryId  String?               @unique
  reconciledAt             DateTime?
  reconciledByUserId       String?
  voidReason               String?
  migratedAt               DateTime              @default(now())
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  user                     User                  @relation("LegacyCarryoverUser", fields: [userId], references: [id], onDelete: Restrict)
  migrationBatch           LegacyMigrationBatch  @relation(fields: [migrationBatchId], references: [id], onDelete: Restrict)

  /// One carryover per member per batch: a member cannot be migrated twice in
  /// the same run, which is the primary double-counting guard.
  /// One carryover per member, ever — the cutover's own rule, enforced by the
  /// database rather than by a read performed outside the write transaction.
  /// Without it a second migration batch creates a second carryover for the
  /// same member, and because every reconciliation identity derives from the
  /// carryover id, both reconcile successfully and credit the same legacy rows
  /// twice.
  reconciliationPolicy LegacyReconciliationPolicy? @relation(fields: [reconciliationPolicyId], references: [id], onDelete: Restrict)

  @@unique([userId])
  @@unique([userId, migrationBatchId])
  @@index([status])
  @@index([userId])
  @@index([migrationBatchId])
}

