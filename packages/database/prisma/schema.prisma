  candidates               Candidate[]
  polls                    Poll[]
  posts                    Post[]
  feedbackItems            Feedback[]
  agentActivities          AgentActivity[]
  incidents                Incident[]
  fieldTasks               FieldTask[]
  broadcastMessages        BroadcastMessage[]
  voterEngagementTasks     VoterEngagementTask[]
  campaignEvents           CampaignEvent[]
  electionDayReports       ElectionDayReport[]
  evidenceAssets           EvidenceAsset[]
  legalCases               LegalCase[]

  @@unique([wardId, name])
  @@unique([stateId, sourceCodeNamespace, sourceCode])
  @@index([stateId])
  @@index([lgaId])
  @@index([wardId])
  @@index([referenceImportReleaseId])
  @@index([geodataImportReleaseId])
}

model SenatorialDistrictLga {
  senatorialDistrictId String
  lgaId                String
  createdAt            DateTime           @default(now())
  senatorialDistrict   SenatorialDistrict @relation(fields: [senatorialDistrictId], references: [id], onDelete: Cascade)
  lga                  LGA                @relation(fields: [lgaId], references: [id], onDelete: Cascade)

  @@id([senatorialDistrictId, lgaId])
  @@index([lgaId])
}

