  @@index([active])
  @@index([createdByUserId])
}

model PayoutCycle {
  id               String        @id @default(cuid())
  name             String
  opensAt          DateTime
  closesAt         DateTime
  payoutDate       DateTime
  minimumThreshold Int
  conversionRate   Decimal       @db.Decimal(18, 4)
  /// The versioned configuration these terms were snapshotted from.
  ///
  /// Null means the cycle predates the payout authority, when this route
  /// accepted a caller-supplied threshold and rate and preferred them over the
  /// stored configuration. Such a cycle's amounts were never server-derived, so
  /// its assignments are refused at execution rather than paid at a rate nobody
  /// authorised. Nullable so no historical row is rewritten to look authorised.
  payoutConfigurationId String?
  status           PayoutStatus  @default(PENDING)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  batches          PayoutBatch[]
  assignments      PayoutAssignment[]
  payoutConfiguration PayoutConfiguration? @relation(fields: [payoutConfigurationId], references: [id], onDelete: Restrict)

  @@index([status, payoutDate])
}

