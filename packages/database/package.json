{
  "name": "@pics-nigeria/database",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "prisma:validate": "prisma validate --config prisma.config.ts",
    "prisma:migrate": "prisma migrate dev --config prisma.config.ts",
    "prisma:migrate:create": "prisma migrate dev --create-only --config prisma.config.ts",
    "prisma:migrate:deploy": "prisma migrate deploy --config prisma.config.ts",
    "prisma:ensure-production": "tsx scripts/ensure-production-schema.ts",
    "bootstrap:reference-data": "tsx scripts/bootstrap-reference-data.ts",
    "bootstrap:polling-units:national": "tsx scripts/bootstrap-national-polling-units.ts",
    "import:reference:ogun": "tsx scripts/import-ogun-reference-release.ts",
    "validate:reference:ogun-release": "tsx scripts/import-ogun-reference-release.ts --validate-only",
    "bootstrap:staging-personas": "tsx scripts/bootstrap-staging-personas.ts",
    "bootstrap:super-admin": "tsx scripts/bootstrap-super-admin.ts",
    "verify:reference-completeness": "tsx scripts/verify-reference-completeness.ts",
    "verify:reference:ogun": "tsx scripts/verify-ogun-reference.ts",
    "verify:reference:ogun:allow-incomplete": "tsx scripts/verify-ogun-reference.ts --allow-incomplete",
    "report:reference:ogun": "tsx scripts/report-ogun-reference-levels.ts",
    "verify:reference:ogun-contract": "tsx scripts/verify-ogun-reference-contract.ts",
    "verify:production": "tsx scripts/verify-production-readiness.ts",
    "migrate:phase1-identities": "tsx scripts/migrate-phase1-identities.ts",
    "seed": "tsx prisma/seed.ts",
    "seed:credentials": "tsx scripts/print-seeded-credentials.ts",
    "bootstrap:check": "tsx scripts/check-bootstrap.ts",
    "migrate:legacy-balances": "tsx scripts/migrate-legacy-balances.ts",
    "backfill:member-ancestry": "tsx scripts/backfill-member-ancestry.ts"
  },
  "dependencies": {
    "@pics-nigeria/shared": "1.0.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "prisma": "6.19.3",
    "tsx": "^4.19.3",
    "xlsx": "^0.18.5"
  }
}
