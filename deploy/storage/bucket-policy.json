{
  "Version": "2012-10-17",
  "Id": "OgunPrivateEvidenceAndIdentityDocuments",
  "Statement": [
    {
      "Sid": "DenyPublicRead",
      "Effect": "Deny",
      "Principal": "*",
      "Action": ["s3:GetObject", "s3:ListBucket"],
      "Resource": ["arn:aws:s3:::BUCKET_NAME", "arn:aws:s3:::BUCKET_NAME/*"],
      "Condition": {
        "StringNotEquals": {
          "aws:PrincipalArn": "APPLICATION_PRINCIPAL_ARN"
        }
      }
    },
    {
      "Sid": "DenyUnencryptedTransport",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": ["arn:aws:s3:::BUCKET_NAME", "arn:aws:s3:::BUCKET_NAME/*"],
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "false"
        }
      }
    },
    {
      "Sid": "AllowApplicationToDeleteOnlyUncommittedRegistrationObjects",
      "Effect": "Allow",
      "Principal": {
        "AWS": "APPLICATION_PRINCIPAL_ARN"
      },
      "Action": "s3:DeleteObject",
      "Resource": "arn:aws:s3:::BUCKET_NAME/voter-verification/pending/*"
    },
    {
      "Sid": "DenyApplicationDeleteOutsideThePendingNamespace",
      "Effect": "Deny",
      "Principal": {
        "AWS": "APPLICATION_PRINCIPAL_ARN"
      },
      "Action": ["s3:DeleteObject", "s3:DeleteObjectVersion", "s3:PutObjectRetention"],
      "NotResource": "arn:aws:s3:::BUCKET_NAME/voter-verification/pending/*"
    },
    {
      "Sid": "DenyDeletionByAnyoneButTheCustodian",
      "Effect": "Deny",
      "Principal": "*",
      "Action": ["s3:DeleteObject", "s3:DeleteObjectVersion", "s3:PutObjectRetention"],
      "Resource": "arn:aws:s3:::BUCKET_NAME/*",
      "Condition": {
        "StringNotEquals": {
          "aws:PrincipalArn": ["EVIDENCE_CUSTODIAN_PRINCIPAL_ARN", "APPLICATION_PRINCIPAL_ARN"]
        }
      }
    }
  ]
}
